<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:openDrawer="start">

    <!-- Main Content Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="48dp">

        <!-- Top Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/bogart_cream">

            <ImageButton
                android:id="@+id/btnInstructions"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_info"
                app:tint="@color/bogart_cream"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/btn_info" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Session Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/infoCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@color/bogart_grey"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/msg_idle"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:id="@+id/tvTotalDuration"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_time_infinite"
                        android:textColor="@color/bogart_tan"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvVideoLength"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_video_unknown"
                        android:textColor="@color/bogart_tan"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvEndTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_est_never"
                        android:textColor="@color/bogart_tan"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Reserved space for secondary status -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:id="@+id/tvSecondaryStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_ready"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:visibility="visible" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Parameters Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            app:layout_constraintTop_toBottomOf="@id/infoCard"
            app:layout_constraintBottom_toTopOf="@id/buttonRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/boxInterval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/boxDelay"
                app:layout_constraintWidth_percent="0.5">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_interval"
                    android:textColor="@color/bogart_tan"
                    android:textSize="12sp" />
                <NumberPicker
                    android:id="@+id/npInterval"
                    android:layout_width="wrap_content"
                    android:layout_height="110dp"
                    android:theme="@style/Theme.Intervalometer.Picker" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxDelay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/boxInterval"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_delay"
                    android:textColor="@color/bogart_tan"
                    android:textSize="12sp" />
                <NumberPicker
                    android:id="@+id/npStartDelay"
                    android:layout_width="wrap_content"
                    android:layout_height="110dp"
                    android:theme="@style/Theme.Intervalometer.Picker" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxPhotos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/boxInterval"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/boxFps"
                app:layout_constraintWidth_percent="0.5"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_photos"
                    android:textColor="@color/bogart_tan"
                    android:textSize="12sp" />
                <NumberPicker
                    android:id="@+id/npPhotoCount"
                    android:layout_width="wrap_content"
                    android:layout_height="110dp"
                    android:theme="@style/Theme.Intervalometer.Picker" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxFps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/boxDelay"
                app:layout_constraintStart_toEndOf="@id/boxPhotos"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.5"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_fps"
                    android:textColor="@color/bogart_tan"
                    android:textSize="12sp" />
                <NumberPicker
                    android:id="@+id/npFps"
                    android:layout_width="wrap_content"
                    android:layout_height="110dp"
                    android:theme="@style/Theme.Intervalometer.Picker" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxShutter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/boxPhotos"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_shutter"
                    android:textColor="@color/bogart_tan"
                    android:textSize="12sp" />
                <NumberPicker
                    android:id="@+id/npShutterDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="110dp"
                    android:orientation="horizontal"
                    android:theme="@style/Theme.Intervalometer.Picker" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Bottom Buttons -->
        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShoot"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="2"
                android:text="@string/btn_start"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/muted_green"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"
                app:cornerRadius="12dp"
                android:enabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSingleShot"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/btn_photo"
                android:textColor="@color/white"
                app:backgroundTint="@color/bogart_grey"
                app:cornerRadius="12dp"
                android:enabled="false" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Left Drawer (Controls) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navLeft"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingBottom="24dp"
            android:paddingTop="64dp">

            <TextView
                android:id="@+id/drawerHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAllCaps="true"
                android:textColor="@color/bogart_cream"
                android:textStyle="bold"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/drawerSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_controls"
                android:textColor="@color/bogart_tan"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnectDrawer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_connect"
                android:textColor="@color/white"
                app:backgroundTint="@color/bogart_tan"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swAutoReconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto-Reconnect"
                android:textColor="@color/white"
                android:checked="true"
                app:thumbTint="@color/white"
                app:trackTint="@color/bogart_tan"
                android:layout_marginBottom="24dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/bogart_grey"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_theme"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:padding="8dp"
                app:drawableStartCompat="@drawable/ic_info"
                android:drawablePadding="12dp"
                app:drawableTint="@color/bogart_tan" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_language"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:padding="8dp"
                android:layout_marginTop="8dp"
                app:drawableStartCompat="@drawable/ic_info"
                android:drawablePadding="12dp"
                app:drawableTint="@color/bogart_tan" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_exit"
                android:textColor="@color/white"
                app:icon="@drawable/ic_power"
                app:iconTint="@color/white" />

        </LinearLayout>
    </com.google.android.material.navigation.NavigationView>

    <!-- Right Drawer (Guide) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navRight"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/background">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:paddingBottom="24dp"
                android:paddingTop="64dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_title"
                    android:textAllCaps="true"
                    android:textColor="@color/bogart_cream"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_step_1"
                    android:textColor="@color/bogart_tan"
                    android:lineSpacingExtra="4dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_step_2"
                    android:textColor="@color/bogart_tan"
                    android:lineSpacingExtra="4dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_step_3"
                    android:textColor="@color/bogart_tan"
                    android:lineSpacingExtra="4dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guide_step_4"
                    android:textColor="@color/bogart_tan"
                    android:lineSpacingExtra="4dp"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/bogart_grey"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="32dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_title"
                    android:textAllCaps="true"
                    android:textColor="@color/bogart_cream"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_desc"
                    android:textColor="@color/bogart_tan"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>