<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:openDrawer="start">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/black"
            app:navigationIcon="@drawable/ic_menu">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="INTERVALOMETER"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/btnInstructions"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_info"
                    android:contentDescription="Guide"
                    android:layout_marginEnd="8dp" />
            </RelativeLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Session Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surfaceVariant"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status: Idle"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tvTotalDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shooting Time: 00:00:00"
                            android:textColor="@color/onSurfaceVariant"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvVideoLength"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Video Length: 0s"
                            android:textColor="@color/onSurfaceVariant"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvEndTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimated End: --:--"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvBusyWarning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Warning: Intervals &lt; 2s may cause camera 'Busy' errors"
                            android:textColor="@color/error"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Parameters Grid (Wheels) -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:useDefaultMargins="true"
                    android:alignmentMode="alignBounds">

                    <!-- Interval -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Interval (s)"
                            android:textColor="@color/light_grey"
                            android:textSize="12sp" />
                        <NumberPicker
                            android:id="@+id/npInterval"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:theme="@style/Theme.Intervalometer.Picker" />
                    </LinearLayout>

                    <!-- Start Delay -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start Delay (s)"
                            android:textColor="@color/light_grey"
                            android:textSize="12sp" />
                        <NumberPicker
                            android:id="@+id/npStartDelay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:theme="@style/Theme.Intervalometer.Picker" />
                    </LinearLayout>

                    <!-- Photo Count -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Photos (0=∞)"
                            android:textColor="@color/light_grey"
                            android:textSize="12sp" />
                        <NumberPicker
                            android:id="@+id/npPhotoCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:theme="@style/Theme.Intervalometer.Picker" />
                    </LinearLayout>

                    <!-- FPS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Video FPS"
                            android:textColor="@color/light_grey"
                            android:textSize="12sp" />
                        <NumberPicker
                            android:id="@+id/npFps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:theme="@style/Theme.Intervalometer.Picker" />
                    </LinearLayout>

                    <!-- Shutter Duration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_columnSpan="2"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shutter Hold (ms)"
                            android:textColor="@color/light_grey"
                            android:textSize="12sp" />
                        <NumberPicker
                            android:id="@+id/npShutterDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:theme="@style/Theme.Intervalometer.Picker" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShoot"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="2"
                android:text="START"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@color/success_green"
                android:layout_marginEnd="8dp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSingleShot"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="PHOTO"
                app:backgroundTint="@color/surfaceVariant"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Left Drawer (Controls) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navLeft"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/background">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <TextView
                android:id="@+id/drawerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROLS"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginBottom="32dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/drawerTitle"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDrawerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Idle"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnectDrawer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CONNECT / WAKE"
                    app:backgroundTint="@color/primary"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAutoReconnect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto-Reconnect"
                    android:textColor="@color/white"
                    android:checked="true"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:text="EXIT APP"
                android:textColor="@color/canon_red"
                app:icon="@drawable/ic_power"
                app:iconTint="@color/canon_red" />

        </RelativeLayout>
    </com.google.android.material.navigation.NavigationView>

    <!-- Right Drawer (Guide) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navRight"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/background">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SETUP GUIDE"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Pair Camera\nGo to Camera Wireless Settings > Bluetooth > Pair with Phone.\n\n2. Set Drive Mode\nOn Camera: Set Drive Mode to 'Remote Control' or 'Self-timer/Remote'.\n\n3. Manual Focus\nHighly recommended: Set lens to MF to avoid focus lock delays.\n\n4. App Settings\nUse the wheels on the main screen to set your interval and shot count."
                    android:textColor="@color/onBackground"
                    android:lineSpacingExtra="4dp"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/surfaceVariant"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="32dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABOUT"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Canon Intervalometer v1.0.0\nProfessional tool for Canon M/R series."
                    android:textColor="@color/onBackground"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>